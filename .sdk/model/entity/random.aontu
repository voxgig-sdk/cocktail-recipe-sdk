# Entity: random

main: kit: entity: random: {

  alias: field: {}

  fields: [
    {
      name: "drinks"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "idDrink"
      req: false
      type: "`$STRING`"
    }
    {
      name: "strAlcoholic"
      req: false
      type: "`$STRING`"
    }
    {
      name: "strCategory"
      req: false
      type: "`$STRING`"
    }
    {
      name: "strDrink"
      req: false
      type: "`$STRING`"
    }
    {
      name: "strDrinkThumb"
      req: false
      type: "`$STRING`"
    }
    {
      name: "strGlass"
      req: false
      type: "`$STRING`"
    }
    {
      name: "strIngredient1"
      req: false
      type: "`$STRING`"
    }
    {
      name: "strIngredient2"
      req: false
      type: "`$STRING`"
    }
    {
      name: "strInstructions"
      req: false
      type: "`$STRING`"
    }
    {
      name: "strMeasure1"
      req: false
      type: "`$STRING`"
    }
    {
      name: "strMeasure2"
      req: false
      type: "`$STRING`"
    }
  ]

  name: "random"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/random.php"
          parts: [
            "random.php"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.drinks`"
          }
        }
        {
          method: "GET"
          orig: "/randomselection.php"
          parts: [
            "randomselection.php"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.drinks`"
          }
        }
      ]
    }
  }



}
